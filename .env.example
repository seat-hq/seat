# Phase 1 defaults to Robinhood testnet (46630).
# Do not point local work at mainnet CHAIN_ID=4663.
# Leave keys empty here. Copy to a gitignored .env before deploying.

# --- Testnet (authoritative values only; do not invent) ---
RH_TESTNET_RPC_URL=
NEXT_PUBLIC_RH_TESTNET_RPC_URL=
CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_ID=46630

# Optional mainnet RPC (reads only; app/keeper refuse 4663 writes)
RH_RPC_URL=
RH_WS_URL=

# --- Deploy / desk (testnet) ---
PRIVATE_KEY=
USDG_ADDRESS=
OWNER=
LEADER_ADDRESS=
KEEPER_ADDRESS=
DESK_ADDRESS=

# Optional RiskModule.configureDesk after createDesk (USDG base units / bps / seconds)
# MAX_FILL_USDG=
# MAX_POSITION_USDG=
# MAX_GROSS_USDG=
# MAX_DRAWDOWN_BPS=
# MAX_STALENESS_SEC=

# Keeper: PAPER unless live guards pass (46630 + router + verified registry).
EXECUTION_MODE=PAPER
