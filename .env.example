# Defaults to Robinhood testnet (46630). Mainnet deploy is guarded.
# Leave keys empty here. Copy to a gitignored .env before deploying.
# Do not invent token / feed / router addresses. See docs/phase-1-live.md.

# --- Testnet ---
RH_TESTNET_RPC_URL=
NEXT_PUBLIC_RH_TESTNET_RPC_URL=
CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_ID=46630

# --- Mainnet (reads; writes only after CONFIRM_MAINNET deploy) ---
RH_RPC_URL=
NEXT_PUBLIC_RH_RPC_URL=
RH_WS_URL=

# Official 4663 facts (cited; used by DeployMainnet when set):
# USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# SWAP_POOL_FEE=3000
# DEPOSIT_CAP_USDG=50000000000
# CONFIRM_MAINNET=   # must be I_UNDERSTAND to broadcast DeployMainnet
# CONFIRM_SEAT_TGE=  # must be I_UNDERSTAND *with* CONFIRM_MAINNET for DeployPhase2

# --- Deploy / desk ---
PRIVATE_KEY=
USDG_ADDRESS=
OWNER=
LEADER_ADDRESS=
# LEADER_2=
# LEADER_3=
KEEPER_ADDRESS=
DESK_ADDRESS=
# DESK_ADDRESSES=     # comma list for multi-desk keeper
# DESK_FACTORY=       # walk factory.allDesks when DESK_ADDRESS(S) unset
# SEAT_HOLDER=        # defaults to OWNER; receives the 1B $SEAT mint
# LISTING_BOND_SEAT=  # default 100_000e18
# PROTOCOL_FEE_RECIPIENT=

# Cited Uniswap v3 NPM on 4663 (deployments/4663.md). LP mint stays manual.
# POSITION_MANAGER_ADDRESS=0x73991a25C818Bf1f1128dEAaB1492D45638DE0D3
# SEAT_LP_USDG=

# Optional RiskModule.configureDesk after createDesk (USDG base units / bps / seconds)
# MAX_FILL_USDG=
# MAX_POSITION_USDG=
# MAX_GROSS_USDG=
# MAX_DRAWDOWN_BPS=
# MAX_STALENESS_SEC=

# Optional fee / router
# PROTOCOL_FEE_RECIPIENT=
# SWAP_ROUTER_ADDRESS=          # 46630: leave empty (none cited)
# SWAP_ROUTER_CONFIGURED=0      # set 1 after 4663 ExactInputRouter02 is live
# SEAT_SUBMIT_TX=0

# Keeper: PAPER unless live guards pass (Robinhood chain + router + verified registry).
EXECUTION_MODE=PAPER
